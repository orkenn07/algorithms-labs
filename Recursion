#1. Factorial
def factorial(n):
    if n == 0 or n == 1:
        return 1

    return n * factorial(n - 1)


print(factorial(5))

#2. Sum of Numbers
def sumNumbers(n):
    if n == 0:
        return 0

    return n + sumNumbers(n - 1)


print(sumNumbers(5))

#3. Power of a Number
def power(a, n):
    if n == 0:
        return 1

    return a * power(a, n - 1)


print(power(2, 5))

#4. Count Digits
def countDigits(n):
    if n < 10:
        return 1

    return 1 + countDigits(n // 10)


print(countDigits(58321))

#5. Sum of Digits
def sumDigits(n):
    if n == 0:
        return 0

    return n % 10 + sumDigits(n // 10)


print(sumDigits(58321))

#6. Reverse a Number
def reverseNumber(n, result=0):
    if n == 0:
        return result

    return reverseNumber(n // 10, result * 10 + n % 10)


print(reverseNumber(12345))

#7. Fibonacci Number
def fibonacci(n):
    if n <= 1:
        return n

    return fibonacci(n - 1) + fibonacci(n - 2)


print(fibonacci(7))

#8. Greatest Common Divisor (GCD)
def gcd(a, b):
    if b == 0:
        return a

    return gcd(b, a % b)


print(gcd(48, 18))

#9. Recursive Array Sum
def arraySum(arr, index=0):
    if index == len(arr):
        return 0

    return arr[index] + arraySum(arr, index + 1)


print(arraySum([2, 4, 6, 8]))

#10. Find the Maximum Element
def findMax(arr, index=0):
    if index == len(arr) - 1:
        return arr[index]

    maximum = findMax(arr, index + 1)

    if arr[index] > maximum:
        return arr[index]

    return maximum


print(findMax([4, 8, 2, 15, 7]))

#11. Count Occurrences
def countOccurrences(arr, x, index=0):
    if index == len(arr):
        return 0

    count = 1 if arr[index] == x else 0

    return count + countOccurrences(arr, x, index + 1)


print(countOccurrences([2, 5, 2, 8, 2, 9], 2))

#12. Check for Palindrome
def isPalindrome(text):
    if len(text) <= 1:
        return True

    if text[0] != text[-1]:
        return False

    return isPalindrome(text[1:-1])


