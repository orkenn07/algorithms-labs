#Task 7. Delete the Last Node
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


class LinkedList:
    def __init__(self):
        self.head = None

    def deleteLast(self):
        if self.head is None:
            return

        if self.head.next is None:
            self.head = None
            return

        current = self.head

        while current.next.next is not None:
            current = current.next

        current.next = None

    def printList(self):
        current = self.head
        while current is not None:
            print(current.data, end=" -> ")
            current = current.next
        print("NULL")


