print("Dequeue:", queue.dequeue())
print("Is empty:", queue.isEmpty())


#12. Implement a Stack Using Two Queues
from collections import deque


class StackUsingQueues:
    def __init__(self):
        self.q1 = deque()
        self.q2 = deque()

    def push(self, value):
        self.q2.append(value)

        while self.q1:
            self.q2.append(self.q1.popleft())

        self.q1, self.q2 = self.q2, self.q1

    def pop(self):
        if self.isEmpty():
            print("Stack is empty")
            return None
        return self.q1.popleft()

    def peek(self):
        if self.isEmpty():
            return None
        return self.q1[0]

    def isEmpty(self):
        return len(self.q1) == 0


stack = StackUsingQueues()

stack.push(10)
stack.push(20)
stack.push(30)

print("Top:", stack.peek())
print("Pop:", stack.pop())
print("Pop:", stack.pop())
print("Top:", stack.peek())
print("Is empty:", stack.isEmpty())

#13. Browser History Simulation
class BrowserHistory:
    def __init__(self, homepage):
        self.current = homepage
        self.backStack = []
        self.forwardStack = []

    def visit(self, page):
        self.backStack.append(self.current)
        self.current = page
        self.forwardStack.clear()

    def back(self):
        if self.backStack:
            self.forwardStack.append(self.current)
            self.current = self.backStack.pop()
        return self.current

    def forward(self):
        if self.forwardStack:
            self.backStack.append(self.current)
            self.current = self.forwardStack.pop()
        return self.current

    def currentPage(self):
        return self.current


browser = BrowserHistory("Home")

browser.visit("Google")
browser.visit("YouTube")
browser.visit("GitHub")

print("Current:", browser.currentPage())
print("Back:", browser.back())
print("Back:", browser.back())
print("Forward:", browser.forward())
print("Current:", browser.currentPage())

#14. CPU / Printer Task Scheduler
from collections import deque


class PrintTask:
    def __init__(self, task_id, student_name, pages):
        self.task_id = task_id
        self.student_name = student_name
        self.pages = pages


printer_queue = deque()

printer_queue.append(PrintTask(1, "Aman", 5))
printer_queue.append(PrintTask(2, "Ali", 2))
printer_queue.append(PrintTask(3, "Dana", 8))

total_pages = 0

print("Printing order:")

while printer_queue:
    task = printer_queue.popleft()

    print(
        "Task", task.task_id,
        "| Student:", task.student_name,
        "| Pages:", task.pages
    )

    total_pages += task.pages

print("Total pages printed:", total_pages)

#15. Undo/Redo System
class TextEditor:
    def __init__(self):
        self.text = ""
        self.undoStack = []
        self.redoStack = []

    def write(self, text):
        self.undoStack.append(self.text)
        self.text += text
        self.redoStack.clear()

    def undo(self):
        if not self.undoStack:
            print("Nothing to undo")
            return

        self.redoStack.append(self.text)
        self.text = self.undoStack.pop()

    def redo(self):
        if not self.redoStack:
            print("Nothing to redo")
            return

        self.undoStack.append(self.text)
        self.text = self.redoStack.pop()

    def showText(self):
        print("Text:", self.text)


editor = TextEditor()

editor.write("Hello")
editor.write(" World")
editor.showText()

editor.undo()
editor.showText()

editor.redo()
editor.showText()

editor.undo()
editor.undo()
editor.showText()

editor.redo()
editor.showText()

